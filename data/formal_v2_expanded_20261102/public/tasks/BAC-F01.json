{
  "schema_version": "formal-computational-design-1",
  "case_id": "BAC-F01",
  "track": "bacterial_cds",
  "evaluation_engine": "emopec_sd",
  "request": "在 E. coli K-12 MG1655 的真实 lacZ 基因背景下，只编辑给定位置的6nt Shine–Dalgarno序列，将EMOPEC相对活性调至0.20±0.05；同时把起始位点周围35+35nt窗口的RNAfold MFE变化限制在1.0 kcal/mol以内。保留spacing及完整CDS。输出sd决策，公共组装器导出完整上游窗口和CDS。目标是指定计算模型内的表达调节与局部结构保持。",
  "inputs": {
    "host": "Escherichia coli K-12 MG1655",
    "reference_genome": "U00096.3",
    "gene": "lacZ",
    "locus_tag": "b0344",
    "upstream_before_sd": "TAGCTCACTCATTAGGCACCCCAGGCTTTACACTTTATGCTTCCGGCTCGTATGTTGTGTGGAATTGTGAGCGGATAACAATTTCACAC",
    "baseline_sd": "AGGAAA",
    "spacing_sequence": "CAGCT",
    "fixed_cds": "",
    "target_relative_activity": 0.2,
    "editable_region": "6nt SD only; all other genomic-window and CDS bases fixed",
    "public_resources": [],
    "context_scope": "A genomic/construct upstream window; transcription start and complete UTR are not asserted"
  },
  "expected_output": {
    "required_fields": [
      "sd"
    ],
    "artifact": "edited genomic upstream window plus unchanged complete CDS"
  },
  "evaluation_contract": {
    "evidence_type": "empirical_model_prediction_and_computed_local_structure",
    "requirements": [
      {
        "metric": "relative_activity_target_error",
        "operator": "<=",
        "value": 0.05,
        "absolute_tolerance": 1e-10
      },
      {
        "metric": "absolute_mfe_change_kcal_mol",
        "operator": "<=",
        "value": 1.0,
        "absolute_tolerance": 1e-06
      }
    ],
    "threshold_basis": "Benchmark application choices: targets 0.2/0.4/0.6/0.8/0.5, absolute relative-score tolerance 0.05, local MFE-change ceiling 1 kcal/mol. Not original experimental success cutoffs. Original algorithm motivates context-dependent |delta MFE|; original validation phenotypes are not used to set these choices."
  }
}
